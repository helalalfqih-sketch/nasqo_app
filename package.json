{
  "name": "nasqo-pro-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "lint": "tsc --noEmit",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@fontsource/roboto": "5.2.10",
    "@google/genai": "^3.3.0",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@use-gesture/react": "10.3.1",
    "d3": "^7.9.2",
    "eslint": "^10.15.0",
    "express": "^5.3.0",
    "firebase": "^13.3.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
